<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Friflo.Json.Fliox.Hub</id>
    <version>1.0.4</version>
    <title>JSON Fliox Hub</title>
    <authors>Ullrich Praetz</authors>
    <license type="expression">LGPL-3.0-only</license>
    <licenseUrl>https://licenses.nuget.org/LGPL-3.0-only</licenseUrl>
    <icon>package-icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/friflo/Friflo.Json.Fliox</projectUrl>
    <description>Provide an ORM (Object-relational Mapper) and a database Hub targeting NoSQL and key-value databases.
Hub API's: REST/OpenAPI, GraphQL, Batch (HTTP &amp; WebSocket).
The Hub support container relations, CRUD, query, messaging, Pub-Sub (changes &amp; messages) and a admin page (Hub Explorer)</description>
    <copyright>Ullrich Praetz</copyright>
    <repository type="git" url="https://github.com/friflo/Friflo.Json.Fliox" commit="6ac89217ad3ea66f11abfd756a0af323d63315ff" />
    <dependencies>
      <group targetFramework=".NETCoreApp3.1">
        <dependency id="Friflo.Json.Burst" version="1.0.4" exclude="Build,Analyzers" />
        <dependency id="Friflo.Json.Fliox" version="1.0.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Friflo.Json.Burst" version="1.0.4" exclude="Build,Analyzers" />
        <dependency id="Friflo.Json.Fliox" version="1.0.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Friflo.Json.Burst" version="1.0.4" exclude="Build,Analyzers" />
        <dependency id="Friflo.Json.Fliox" version="1.0.4" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Channels" version="7.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Friflo.Json.Burst" version="1.0.4" exclude="Build,Analyzers" />
        <dependency id="Friflo.Json.Fliox" version="1.0.4" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Channels" version="7.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>
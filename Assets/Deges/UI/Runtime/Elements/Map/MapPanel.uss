.nodus-map-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}
.nodus-map-controls {
    position: absolute;
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    flex-direction: column;
    align-items: center;
}
.nodus-map-actions {
    flex-direction: column;
    align-items: center;
}
.nodus-map-actions--with-panel { margin-left: 0; }
.nodus-map-icon-font {
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
}
.nodus-map-icon-button {
    width: 38px;
    height: 38px;
    padding: 0;
    margin-bottom: 8px;
    background-color: var(--nodus-surface);
    color: var(--nodus-text);
    border-width: 1px;
    border-color: var(--nodus-border);
    border-radius: 8px;
    font-size: 22px;
    -unity-text-align: middle-center;
}
.nodus-map-icon-button:hover { background-color: var(--nodus-primary-soft); }
.nodus-map-panel {
    position: absolute;
    left: 26px;
    top: 108px;
    width: 335px;
    flex-shrink: 1;
    min-width: 230px;
    max-width: 80%;
    padding: 18px;
    background-color: var(--nodus-surface);
    color: var(--nodus-text);
    border-width: 1px;
    border-color: var(--nodus-border);
    border-radius: var(--nodus-radius);
}
.nodus-map-heading { flex-direction: row; align-items: center; justify-content: space-between; }
.nodus-map-title {
    font-size: var(--nodus-font-title);
    color: var(--nodus-primary);
    -unity-font-style: bold;
    flex-grow: 1;
}
.nodus-map-header-close {
    width: 28px;
    height: 28px;
    padding: 0;
    background-color: rgba(0,0,0,0);
    color: var(--nodus-text);
    border-width: 0;
    font-size: 20px;
    -unity-text-align: middle-center;
}
.nodus-map-description {
    font-size: var(--nodus-font-small);
    color: var(--nodus-text-muted);
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 8px;
}
.nodus-map-tabs { flex-direction: row; margin-top: 8px; margin-bottom: 8px; }
.nodus-map-button {
    height: 34px;
    min-height: 34px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--nodus-surface-muted);
    color: var(--nodus-text);
    border-width: 1px;
    border-color: var(--nodus-border);
    border-radius: 7px;
    font-size: var(--nodus-font-small);
    -unity-text-align: middle-center;
}
.nodus-map-button:hover { background-color: var(--nodus-primary-soft); }
.nodus-map-selected { background-color: var(--nodus-primary); border-color: var(--nodus-primary); color: #FFFFFF; }
.nodus-map-selected:hover { background-color: var(--nodus-primary-dark); color: #FFFFFF; }
.nodus-map-tab { flex-grow: 1; }
.nodus-map-tab-first { margin-right: 7px; }
.nodus-map-tab-content { margin-top: 4px; }
.nodus-map-slider { margin-top: 10px; margin-bottom: 8px; min-height: 28px; }
.nodus-map-modes { flex-direction: row; margin-top: 4px; }
.nodus-map-mode { flex-grow: 1; }
.nodus-map-mode-middle { margin-left: 7px; margin-right: 7px; }
.nodus-map-phase-index { font-size: var(--nodus-font-small); color: var(--nodus-primary); }
.nodus-map-phase-title { font-size: var(--nodus-font-body); -unity-font-style: bold; color: var(--nodus-text); margin-top: 6px; }
.nodus-map-stepper { flex-direction: row; justify-content: flex-end; margin-top: 8px; }
.nodus-map-step { width: 40px; font-size: 25px; padding: 0; margin-left: 8px; }
.nodus-map-info {
    position: absolute;
    right: 96px;
    bottom: 24px;
    width: 340px;
    max-width: 70%;
    height: auto;
    min-width: 0;
    max-height: 70%;
    padding: 16px;
    background-color: var(--nodus-surface);
    border-width: 1px;
    border-color: var(--nodus-border);
    border-radius: var(--nodus-radius);
}
.nodus-map-info-title {
    font-size: var(--nodus-font-title);
    color: var(--nodus-primary);
    -unity-font-style: bold;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    margin-right: 8px;
}
.nodus-map-info .nodus-map-header-close {
    flex-shrink: 0;
}
.nodus-map-info-description {
    white-space: normal;
    flex-shrink: 1;
}
.nodus-map-info-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 12px;
}
.nodus-map-link { background-color: rgba(0,0,0,0); border-width: 0; color: var(--nodus-primary); padding: 2px; font-size: var(--nodus-font-small); }
.nodus-map-comparison-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.nodus-map-comparison-divider {
    position: absolute;
    top: 114px;
    bottom: 18px;
    width: 2px;
    background-color: #FFFFFF;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: var(--nodus-primary);
}
.nodus-map-comparison-handle {
    position: absolute;
    left: -17px;
    top: 50%;
    margin-top: -18px;
    width: 36px;
    height: 36px;
    background-color: var(--nodus-surface);
    color: var(--nodus-primary);
    border-width: 2px;
    border-color: var(--nodus-primary);
    border-radius: 18px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.nodus-map-comparison-chevron {
    width: 10px;
    height: 28px;
    padding: 0;
    font-size: 20px;
    -unity-text-align: middle-center;
}

.nodus-map-pins {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.nodus-map-pin {
    position: absolute;
    width: 34px;
    height: 34px;
    padding: 0;
    border-width: 2px;
    border-color: #FFFFFF;
    border-radius: 17px;
    background-color: var(--nodus-primary);
    color: #FFFFFF;
    font-size: 19px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/UI/Fonts/Roboto-Regular SDF.asset");
    -unity-font-style: bold;
}
.nodus-map-pin:hover { border-color: var(--nodus-primary); }
.nodus-map-pin--old { background-color: #C48335; }
.nodus-map-pin--new { background-color: #168F84; }
.nodus-map-pin--phase { background-color: #8558B8; }
.nodus-map-pin.nodus-map-selected { border-color: #FFDA67; border-width: 4px; }
.nodus-map-pin--old.nodus-map-selected { background-color: #C48335; }
.nodus-map-pin--new.nodus-map-selected { background-color: #168F84; }
.nodus-map-pin--phase.nodus-map-selected { background-color: #8558B8; }

.nodus-map-info-toggle {
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
    font-size: 22px;
    -unity-text-align: middle-center;
}
.nodus-map-info-toggle-slash {
    position: absolute;
    width: 2px;
    height: 27px;
    left: 17px;
    top: 5px;
    background-color: var(--nodus-text);
    rotate: 45deg;
}

.nodus-map-measure-pin {
    position: absolute;
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    border-width: 2px;
    border-color: #FFFFFF;
    border-radius: 12px;
    background-color: #E29B28;
    color: #FFFFFF;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.nodus-map-measure-label {
    position: absolute;
    background-color: rgba(36, 40, 46, .86);
    color: #FFFFFF;
    font-size: 12px;
    padding: 3px 6px;
    border-radius: 5px;
    -unity-text-align: middle-center;
}
.nodus-map-measure-area {
    background-color: rgba(36, 40, 46, .92);
    color: #FFD47E;
    -unity-font-style: bold;
}

/* North is the first control in the right-side navigation stack. */
.nodus-map-compass-control {
    align-items: center;
    justify-content: center;
}
.nodus-map-compass-arrow {
    width: 32px;
    height: 34px;
    margin: 0;
    padding: 0;
    font-size: 28px;
    color: #d93025;
    -unity-text-align: middle-center;
}

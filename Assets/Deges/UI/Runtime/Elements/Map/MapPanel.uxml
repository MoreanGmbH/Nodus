<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MapPanel.uss" />
    <ui:VisualElement name="MapRoot" picking-mode="Ignore" class="nodus-map-root">
        <ui:VisualElement name="ComparisonOverlay" picking-mode="Ignore" class="nodus-map-comparison-overlay">
            <ui:VisualElement name="ComparisonDivider" class="nodus-map-comparison-divider">
                <ui:VisualElement name="ComparisonHandle" class="nodus-map-comparison-handle">
                <ui:Label text="" picking-mode="Ignore" class="nodus-map-comparison-chevron nodus-map-icon-font" />
                <ui:Label text="" picking-mode="Ignore" class="nodus-map-comparison-chevron nodus-map-icon-font" />
            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MapPins" picking-mode="Ignore" class="nodus-map-pins" />
        <ui:VisualElement name="MeasurementLabels" picking-mode="Ignore" class="nodus-map-pins" />
        <ui:VisualElement name="MeasurementPins" picking-mode="Ignore" class="nodus-map-pins" />
        <ui:VisualElement name="BridgePanel" class="nodus-map-panel">
            <ui:VisualElement class="nodus-map-heading">
                <ui:Label name="ProjectTitle" text="Construction phases" class="nodus-map-title" />
                <ui:Button name="CloseBridgeButton" text="&#xe5cd;" class="nodus-map-header-close nodus-map-icon-font" />
            </ui:VisualElement>
            <ui:VisualElement name="PhasesTab" class="nodus-map-tab-content">
                <ui:Label name="PhaseIndex" text="Phase 1 of 4" class="nodus-map-phase-index" />
                <ui:Label name="PhaseTitle" text="Site setup" class="nodus-map-phase-title" />
                <ui:Label name="PhaseDescription" text="The construction site is prepared." class="nodus-map-description" />
                <ui:VisualElement class="nodus-map-stepper">
                    <ui:Button name="PreviousPhaseButton" text="&#xe5cb;" class="nodus-map-button nodus-map-step nodus-map-icon-font" />
                    <ui:Button name="NextPhaseButton" text="&#xe5cc;" class="nodus-map-button nodus-map-step nodus-map-icon-font" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MapControls" picking-mode="Ignore" class="nodus-map-controls">
            <ui:VisualElement name="MapActions" class="nodus-map-actions">
                <ui:Button name="HomeButton" class="nodus-map-icon-button nodus-map-compass-control" tooltip="Reset map and north">
                    <ui:Label name="CompassArrow" text="&#xe55d;" picking-mode="Ignore" class="nodus-map-compass-arrow nodus-map-icon-font" />
                </ui:Button>
                <ui:Button name="MapViewButton" text="&#xe3ec;" class="nodus-map-icon-button nodus-map-icon-font" />
                <ui:Button name="SatelliteButton" text="" class="nodus-map-icon-button nodus-map-icon-font" />
                <ui:Button name="InfoToggleButton" text="&#xe88e;" class="nodus-map-icon-button nodus-map-icon-font nodus-map-info-toggle">
                    <ui:VisualElement name="InfoToggleSlash" picking-mode="Ignore" class="nodus-map-info-toggle-slash" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="InfoPanel" class="nodus-map-info">
            <ui:VisualElement class="nodus-map-heading nodus-map-info-heading">
                <ui:Label name="InfoTitle" text="" class="nodus-map-info-title" />
                <ui:Button name="CloseInfoButton" text="" class="nodus-map-header-close nodus-map-icon-font" />
            </ui:VisualElement>
            <ui:Label name="InfoDescription" text="" class="nodus-map-description nodus-map-info-description" />
            <ui:VisualElement class="nodus-map-info-footer">
                <ui:Button name="PreviousInfoButton" text="" class="nodus-map-button nodus-map-step nodus-map-icon-font" />
                <ui:Button name="NextInfoButton" text="" class="nodus-map-button nodus-map-step nodus-map-icon-font" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:loc="UnityEngine.Localization" xmlns:nodus="Nodus.UI">
    <Style src="../Styles.uss" />
    <ui:VisualElement name="FeedbackPanel" class="nodus-panel nodus-feedback">
        <ui:VisualElement class="nodus-feedback__heading">
            <ui:Label text="Feedback" class="nodus-panel__title">
                <Bindings><loc:LocalizedString property="text" table="MainTable" entry="Feedback" /></Bindings>
            </ui:Label>
            <nodus:EntitiesButton name="FeedbackCloseButton" text="Close" entities="project://database/Assets/Deges/UI/Runtime/Elements/Feedback/CloseFeedback.asset?fileID=11400000&amp;guid=ed5515929495513b8e8f56dccebe0511&amp;type=2#CloseFeedback" class="nodus-button">
                <Bindings><loc:LocalizedString property="text" table="MainTable" entry="Close" /></Bindings>
            </nodus:EntitiesButton>
        </ui:VisualElement>
        <ui:Label text="Tell us what you think about the project." class="nodus-label--small">
            <Bindings><loc:LocalizedString property="text" table="MainTable" entry="Feedback.Description" /></Bindings>
        </ui:Label>
        <ui:TextField name="FeedbackMessage" multiline="true" class="nodus-feedback__text" />
        <ui:Button name="FeedbackSubmitButton" text="Submit" class="nodus-button nodus-button--primary">
            <Bindings><loc:LocalizedString property="text" table="MainTable" entry="Submit" /></Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>

/* Shared project UI styles. Colors and typography come from the active Nodus theme. */

/* Three independent toolbar groups: fixed left title, flexible centered actions, fixed right controls. */
.nodus-toolbar--responsive {
    height: 70px;
    min-height: 70px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
}
.nodus-toolbar__brand-group {
    width: 168px;
    min-width: 168px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}
.nodus-toolbar--responsive .nodus-toolbar__brand {
    flex-shrink: 0;
    margin-right: 0;
    font-size: 18px;
}
.nodus-toolbar--responsive .nodus-toolbar__items {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
}
.nodus-toolbar__right {
    width: 182px;
    min-width: 182px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}
.nodus-toolbar__settings {
    width: 90px;
    min-width: 90px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: stretch;
    margin-left: 6px;
    padding-top: 0;
    padding-bottom: 0;
}

.nodus-select-wrap--second { margin-top: 8px; }

.nodus-select-wrap {
    position: relative;
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 28px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.nodus-select {
    width: 100%;
    height: 28px;
    min-height: 28px;
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 12px;
    color: var(--nodus-text);
}

.nodus-select .unity-base-popup-field__input,
.nodus-select .unity-popup-field__input {
    width: 100%;
    height: 28px;
    min-height: 28px;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    background-color: var(--nodus-surface-muted);
    border-width: 1px;
    border-color: var(--nodus-border);
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 27px;
}

.nodus-select:hover .unity-base-popup-field__input,
.nodus-select:hover .unity-popup-field__input {
    background-color: var(--nodus-primary-soft);
    border-color: var(--nodus-primary);
}

.nodus-select .unity-base-popup-field__text,
.nodus-select .unity-popup-field__text {
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 0;
    white-space: nowrap;
    overflow: visible;
    -unity-text-align: middle-left;
    font-size: 12px;
    color: var(--nodus-text);
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
}

.nodus-select .unity-base-popup-field__arrow,
.nodus-select .unity-popup-field__arrow {
    display: none;
}

.nodus-select-icon {
    position: absolute;
    right: 7px;
    top: 0;
    bottom: 0;
    width: 15px;
    font-size: 15px;
    color: var(--nodus-text);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
}

.nodus-icon-button {
    width: 36px;
    height: 36px;
    min-height: 36px;
    flex-shrink: 0;
    margin-right: 4px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 22px;
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
}

.nodus-toolbar--responsive .nodus-button--primary {
    height: 36px;
    min-height: 36px;
    padding-left: 14px;
    padding-right: 14px;
}

.nodus-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Compact navigation: Material icon + label, separators, one blue active state. */
.nodus-toolbar-action {
    height: 38px;
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 7px;
}
.nodus-toolbar-action__icon {
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
    font-size: 19px;
    margin-right: 6px;
    color: var(--nodus-text-muted);
}
.nodus-toolbar-action__text {
    font-size: 12px;
    color: var(--nodus-text);
    -unity-text-align: middle-center;
}
.nodus-toolbar-action--active { background-color: var(--nodus-primary); color: #FFFFFF; }
.nodus-toolbar-action--active:hover { background-color: var(--nodus-primary-dark); color: #FFFFFF; }
.nodus-toolbar-action--active .nodus-toolbar-action__icon,
.nodus-toolbar-action--active .nodus-toolbar-action__text { color: #FFFFFF; }
.nodus-toolbar-separator {
    width: 1px;
    height: 27px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: var(--nodus-border);
    flex-shrink: 0;
}
.nodus-toolbar-history {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
}
.nodus-toolbar-history-button {
    width: 37px;
    min-width: 37px;
    height: 38px;
    margin-right: 0;
    border-radius: 7px;
}
.nodus-feedback-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.nodus-feedback-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.46);
}
.nodus-feedback {
    position: relative;
    width: 440px;
    max-width: 90%;
    min-height: 290px;
    padding: 22px;
    background-color: var(--nodus-surface);
    border-width: 1px;
    border-color: var(--nodus-border);
    border-radius: var(--nodus-radius);
}

.nodus-feedback__heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.nodus-feedback__text {
    min-height: 130px;
    margin-top: 10px;
    margin-bottom: 14px;
}

.nodus-button--primary .nodus-toolbar-action__icon,
.nodus-button--primary .nodus-toolbar-action__text { color: #FFFFFF; }

/* At narrow widths, hide action labels before shrinking controls. */
.nodus-toolbar--compact .nodus-toolbar-action__text { display: none; }
.nodus-toolbar--compact .nodus-toolbar-action__icon { margin-right: 0; }
.nodus-toolbar--compact .nodus-toolbar-action { width: 36px; min-width: 36px; padding-left: 0; padding-right: 0; }
.nodus-toolbar--compact .nodus-toolbar-separator { margin-left: 3px; margin-right: 3px; }
.nodus-toolbar--compact .nodus-toolbar__brand-group { width: 148px; min-width: 148px; }
.nodus-toolbar--narrow .nodus-toolbar__brand-group { display: none; }
.nodus-toolbar--narrow .nodus-toolbar__right { width: 156px; min-width: 156px; }
.nodus-toolbar--narrow .nodus-toolbar__settings { width: 78px; min-width: 78px; }
.nodus-toolbar--narrow .nodus-toolbar-history-button { width: 32px; min-width: 32px; }

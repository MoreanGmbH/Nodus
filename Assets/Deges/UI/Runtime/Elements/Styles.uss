/* Shared project UI styles. Colors and typography come from the active Nodus theme. */

.nodus-toolbar--responsive {
    height: auto;
    min-height: 66px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.nodus-toolbar--responsive .nodus-toolbar__items {
    flex-grow: 1;
    flex-shrink: 0;
    flex-wrap: wrap;
    align-items: center;
}

.nodus-toolbar__settings {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: center;
    flex-shrink: 0;
    margin-left: auto;
    padding-top: 0;
    padding-bottom: 0;
}

.nodus-select-wrap {
    position: relative;
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 28px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.nodus-select-wrap--second { margin-top: 6px; }

.nodus-select {
    width: 100%;
    height: 28px;
    min-height: 28px;
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 12px;
    color: var(--nodus-text);
}

.nodus-select .unity-base-popup-field__input,
.nodus-select .unity-popup-field__input {
    width: 100%;
    height: 28px;
    min-height: 28px;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    background-color: var(--nodus-surface-muted);
    border-width: 1px;
    border-color: var(--nodus-border);
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 27px;
}

.nodus-select:hover .unity-base-popup-field__input,
.nodus-select:hover .unity-popup-field__input {
    background-color: var(--nodus-primary-soft);
    border-color: var(--nodus-primary);
}

.nodus-select .unity-base-popup-field__text,
.nodus-select .unity-popup-field__text {
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 0;
    white-space: nowrap;
    overflow: visible;
    -unity-text-align: middle-left;
    font-size: 12px;
    color: var(--nodus-text);
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
}

.nodus-select .unity-base-popup-field__arrow,
.nodus-select .unity-popup-field__arrow {
    display: none;
}

.nodus-select-icon {
    position: absolute;
    right: 7px;
    top: 0;
    bottom: 0;
    width: 15px;
    font-size: 15px;
    color: var(--nodus-text);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
}

.nodus-icon-button {
    width: 36px;
    height: 36px;
    min-height: 36px;
    flex-shrink: 0;
    margin-right: 4px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 22px;
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
}

.nodus-toolbar--responsive .nodus-button--primary {
    height: 36px;
    min-height: 36px;
    padding-left: 14px;
    padding-right: 14px;
}

.nodus-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.nodus-feedback {
    position: absolute;
    top: 108px;
    left: 26px;
    right: 26px;
    width: auto;
    max-width: 380px;
    min-height: 290px;
    border-width: 1px;
    border-color: var(--nodus-border);
}

.nodus-feedback__heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.nodus-feedback__text {
    min-height: 130px;
    margin-top: 10px;
    margin-bottom: 14px;
}

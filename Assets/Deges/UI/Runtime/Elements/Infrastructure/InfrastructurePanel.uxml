<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:loc="UnityEngine.Localization">
    <Style src="../Styles.uss" />
    <ui:VisualElement name="App" class="nodus-root">
        <ui:VisualElement name="Toolbar" class="nodus-toolbar nodus-toolbar--responsive">
            <ui:Label text="Infrastructure" class="nodus-toolbar__brand">
                <Bindings>
                    <loc:LocalizedString property="text" table="MainTable" entry="Project.Title" />
                </Bindings>
            </ui:Label>
            <ui:VisualElement class="nodus-toolbar__items">
                <ui:Button name="BackButton" text="" class="nodus-button nodus-icon-button" />
                <ui:Button name="ForwardButton" text="" class="nodus-button nodus-icon-button" />
                <ui:Button name="OpenFeedbackButton" text="Feedback" class="nodus-button nodus-button--primary">
                    <Bindings>
                        <loc:LocalizedString property="text" table="MainTable" entry="Feedback" />
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="nodus-toolbar__settings">
                <ui:VisualElement class="nodus-select-wrap">
                    <ui:DropdownField name="LanguageDropdown" class="nodus-select" />
                    <ui:Label text="" class="nodus-select-icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="nodus-select-wrap">
                    <ui:DropdownField name="ThemeDropdown" class="nodus-select" />
                    <ui:Label text="" class="nodus-select-icon" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Panels" class="nodus-stack" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>

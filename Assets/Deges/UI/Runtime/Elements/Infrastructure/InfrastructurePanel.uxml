<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Deges/UI/Runtime/Elements/Styles.uss?fileID=7433441132597879392&amp;guid=a64a3905c8a435845a8377002c55e1ed&amp;type=3#Styles"/>
    <ui:VisualElement name="App" class="nodus-root deges-app">
        <ui:VisualElement name="Toolbar" class="nodus-toolbar deges-toolbar">
            <ui:Label text="Infrastructure" class="nodus-toolbar__brand"/>
            <ui:VisualElement class="nodus-toolbar__items">
                <ui:Button name="BackButton" text="" tooltip="Back" class="nodus-button deges-icon-button"/>
                <ui:Button name="ForwardButton" text="" tooltip="Forward" class="nodus-button deges-icon-button"/>
                <ui:Button name="OpenFeedbackButton" text="Feedback" class="nodus-button nodus-button--primary">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:ddb80f7d327c4b949bf146a72625f877" entry="Id(610257920000)"/>
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="deges-toolbar-settings">
                <ui:VisualElement class="deges-select-wrap deges-select-wrap--language">
                    <ui:DropdownField name="LanguageDropdown" tooltip="Language" class="deges-select"/>
                    <ui:Label text="" picking-mode="Ignore" class="deges-select-icon"/>
                </ui:VisualElement>
                <ui:VisualElement class="deges-select-wrap deges-select-wrap--theme">
                    <ui:DropdownField name="ThemeDropdown" tooltip="Theme" class="deges-select"/>
                    <ui:Label text="" picking-mode="Ignore" class="deges-select-icon"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Panels" picking-mode="Ignore" class="deges-stack"/>
    </ui:VisualElement>
</ui:UXML>

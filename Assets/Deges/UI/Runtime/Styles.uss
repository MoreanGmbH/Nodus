/* Project UI layout and controls. Theme colors come from ThemeProfile. */
.deges-app {
    flex-grow: 1;
}

.deges-toolbar {
    min-height: 66px;
    height: auto;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.deges-toolbar .nodus-toolbar__items {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 250px;
}

.deges-toolbar-settings {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 420px;
    justify-content: flex-end;
    align-items: center;
    min-width: 0;
}

.deges-select-wrap {
    height: 36px;
    margin-left: 10px;
    margin-top: 3px;
    margin-bottom: 3px;
    position: relative;
    flex-shrink: 1;
    min-width: 0;
}

.deges-select-wrap--language {
    flex-basis: 130px;
    min-width: 120px;
    max-width: 200px;
}

.deges-select-wrap--theme {
    flex-grow: 1;
    flex-basis: 185px;
    min-width: 180px;
    max-width: 250px;
}

.deges-select {
    width: 100%;
    height: 100%;
    min-height: 36px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: var(--nodus-font-body);
    color: var(--nodus-text);
}

.deges-select .unity-base-popup-field__input,
.deges-select .unity-popup-field__input {
    height: 36px;
    min-height: 36px;
    width: 100%;
    min-width: 0;
    background-color: var(--nodus-surface-muted);
    border-width: 1px;
    border-color: var(--nodus-border);
    border-radius: 8px;
    padding-left: 12px;
    padding-right: 32px;
    align-items: center;
}

.deges-select:hover .unity-base-popup-field__input,
.deges-select:hover .unity-popup-field__input {
    background-color: var(--nodus-primary-soft);
    border-color: var(--nodus-primary);
}

.deges-select .unity-base-popup-field__text,
.deges-select .unity-popup-field__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: var(--nodus-font-body);
    color: var(--nodus-text);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.deges-select .unity-base-popup-field__arrow,
.deges-select .unity-popup-field__arrow {
    display: none;
}

.deges-select-icon {
    position: absolute;
    right: 10px;
    top: 0;
    bottom: 0;
    width: 20px;
    font-size: 20px;
    color: var(--nodus-text);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
}

.deges-icon-button {
    width: 36px;
    height: 36px;
    min-height: 36px;
    margin-right: 4px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 22px;
    -unity-font-definition: url("/Assets/UI/Fonts/MaterialIcons-Regular SDF.asset");
}

.deges-toolbar .nodus-button--primary {
    height: 36px;
    min-height: 36px;
    padding-left: 14px;
    padding-right: 14px;
}

.deges-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.deges-feedback {
    position: absolute;
    top: 108px;
    right: 26px;
    width: auto;
    max-width: 380px;
    left: 26px;
    min-height: 290px;
    border-width: 1px;
    border-color: var(--nodus-border);
}

.deges-feedback-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.deges-feedback-text {
    min-height: 130px;
    margin-top: 10px;
    margin-bottom: 14px;
}
